# ---- Postgres (single instance, two databases) ----
# Prisma CMS: "ecom" db, "cms" schema.
CMS_DATABASE_URL="postgres://<user>@localhost:5432/ecom?schema=cms"
# Medusa: dedicated "medusa" db (configured in apps/medusa/apps/backend/.env).
MEDUSA_DATABASE_URL="postgres://<user>@localhost:5432/medusa"

# ---- Redis (Medusa cache / events / workflows) ----
REDIS_URL="redis://localhost:6379"

# ---- Medusa ----
MEDUSA_BACKEND_URL="http://localhost:9000"
MEDUSA_ADMIN_CORS="http://localhost:3000,http://localhost:7001"
MEDUSA_STORE_CORS="http://localhost:3000"
JWT_SECRET="change-me-in-prod"
COOKIE_SECRET="change-me-in-prod"

# ---- Next.js web ----
NEXT_PUBLIC_MEDUSA_BACKEND_URL="http://localhost:9000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Medusa publishable API key (create after seeding Medusa)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=""
# Admin access. Multi-user auth + roles (AdminUser table) is the source of truth.
# On first run (no users yet), signing in with ADMIN_BOOTSTRAP_EMAIL +
# ADMIN_PASSWORD seeds the first ADMIN account, after which login is per-user.
ADMIN_BOOTSTRAP_EMAIL="owner@yourbrand.com"
ADMIN_PASSWORD="set-a-strong-admin-password"
# Signs the admin session cookie (HMAC). Generate a long random string.
ADMIN_SESSION_SECRET="generate-a-long-random-string"
# Medusa admin secret key for server-side order/parcel lookup (NEVER public).
# Generate: cd apps/medusa/apps/backend && npx medusa exec ./src/scripts/create-storefront-api-key.ts
MEDUSA_ADMIN_API_KEY=""

# ---- Payments (dev) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Image search (later phase) ----
EMBEDDINGS_SERVICE_URL=""
