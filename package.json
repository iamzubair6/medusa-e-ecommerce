{
  "name": "e-com",
  "private": true,
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter web dev",
    "build": "bun run --filter web build",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
