// CMS content models — Prisma owns the Postgres "cms" schema.
// Commerce data (products, carts, orders) lives in Medusa's own tables and is
// NOT modeled here. We reference Medusa entities by their string ids.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CMS_DATABASE_URL")
  schemas  = ["cms"]
}

// ---------------------------------------------------------------------------
// Page composition
// ---------------------------------------------------------------------------

/// A composable page (home, landing, campaign). Ordered list of sections.
model PageLayout {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  status      Status    @default(DRAFT)
  publishedAt DateTime?
  sections    Section[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("cms")
}

/// One block on a page. `config` is validated by a Zod schema keyed on `type`.
model Section {
  id           String      @id @default(cuid())
  type         SectionType
  position     Int         @default(0)
  config       Json        @default("{}")
  pageLayout   PageLayout  @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
  pageLayoutId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([pageLayoutId, position])
  @@schema("cms")
}

enum SectionType {
  HERO
  PRODUCT_ROW // featured / new / best-sellers (config carries source + heading)
  CATEGORY_GRID
  EDITORIAL // image + copy block
  BANNER
  MARQUEE

  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------

model NavMenu {
  id        String    @id @default(cuid())
  /// e.g. "main" | "footer"
  key       String    @unique
  items     NavItem[]
  updatedAt DateTime  @updatedAt

  @@schema("cms")
}

model NavItem {
  id        String    @id @default(cuid())
  label     String
  href      String
  position  Int       @default(0)
  /// optional mega-menu payload (columns, featured image), validated by Zod
  megaMenu  Json?
  menu      NavMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    String
  parent    NavItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  children  NavItem[] @relation("NavChildren")

  @@index([menuId, position])
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Popup {
  id          String       @id @default(cuid())
  name        String
  active      Boolean      @default(false)
  trigger     PopupTrigger @default(TIMER)
  /// trigger detail (delay ms, scroll %, exit-intent) + content, validated by Zod
  config      Json         @default("{}")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@schema("cms")
}

enum PopupTrigger {
  TIMER
  SCROLL
  EXIT_INTENT
  IMMEDIATE

  @@schema("cms")
}

/// A scheduled content/promo "run".
model Campaign {
  id        String         @id @default(cuid())
  name      String
  status    CampaignStatus @default(SCHEDULED)
  startsAt  DateTime
  endsAt    DateTime?
  /// arbitrary payload: which layout/sections/popups to activate, validated by Zod
  payload   Json           @default("{}")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, startsAt])
  @@schema("cms")
}

enum CampaignStatus {
  SCHEDULED
  ACTIVE
  ENDED
  PAUSED

  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Guest lead capture (abandoned info / cart, for remarketing)
// ---------------------------------------------------------------------------

model GuestLead {
  id             String   @id @default(cuid())
  email          String?
  phone          String?
  /// captured form fields (name, address, etc.)
  capturedFields Json     @default("{}")
  /// Medusa cart id, if any
  cartId         String?
  source         String?  // "checkout-step" | "popup" | "newsletter"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([cartId])
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  type      MediaType @default(IMAGE)
  alt       String?
  width     Int?
  height    Int?
  /// {x,y} 0..1 focal point for art-directed crops
  focal     Json?
  createdAt DateTime  @default(now())

  @@schema("cms")
}

enum MediaType {
  IMAGE
  VIDEO

  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Visual search (image embeddings for "Shop Similar")
// ---------------------------------------------------------------------------

/// A product image feature vector for visual-similarity search. Vectors are
/// computed locally (sharp) and ranked by cosine similarity in the app.
model ProductEmbedding {
  id        String   @id @default(cuid())
  productId String   @unique
  handle    String
  title     String
  thumbnail String
  price     String
  dim       Int
  vector    Float[]
  updatedAt DateTime @updatedAt

  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

/// Customer product reviews (rating + text), keyed by the Medusa product handle.
model ProductReview {
  id            String   @id @default(cuid())
  productHandle String
  rating        Int /// 1–5
  author        String
  title         String?
  body          String
  approved      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([productHandle, createdAt])
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// Shared
// ---------------------------------------------------------------------------

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("cms")
}
