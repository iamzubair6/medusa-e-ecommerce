# Copy to ".env" in the repo root for docker compose. NEVER commit the real .env.

# --- Postgres (one DB, two schemas: public=Medusa, cms=Prisma) ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=ecom

# --- Medusa secrets (generate long random strings) ---
JWT_SECRET=change-me-long-random
COOKIE_SECRET=change-me-long-random

# --- URLs ---
# No domain (test by IP): use http://<SERVER_IP>:3000 and :9000
# With domains (--profile tls): use https://yourdomain.com and https://api.yourdomain.com
SITE_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000

# CORS — must include the storefront origin(s)
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# --- Storefront ↔ Medusa keys (fill AFTER first boot, see DEPLOY_DOCKER.md) ---
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_API_KEY=

# --- CMS admin access (multi-user auth + roles) ---
# First-run only: ADMIN_BOOTSTRAP_EMAIL + ADMIN_PASSWORD seed the first ADMIN.
ADMIN_BOOTSTRAP_EMAIL=owner@yourbrand.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-me-long-random

# --- Domains (only for --profile tls) ---
DOMAIN=
API_DOMAIN=
